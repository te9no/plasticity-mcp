{
  "name": "plasticity-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Local MCP server for Plasticity native CAD operations and STEP exchange",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "plasticity-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "smoke": "tsx src/smoke.ts",
    "test": "tsx src/protocol.test.ts && tsx --test src/cdp.test.ts src/sketch.test.ts",
    "smoke:native": "tsx scripts/smoke-native.ts",
    "smoke:detail": "tsx scripts/smoke-detail.ts",
    "smoke:exchange": "tsx scripts/smoke-exchange.ts",
    "smoke:sketch": "tsx scripts/smoke-sketch.ts",
    "smoke:constraints": "tsx scripts/smoke-constraints.ts",
    "smoke:recovery": "tsx scripts/smoke-recovery.ts",
    "smoke:document": "tsx scripts/smoke-document.ts",
    "smoke:parts": "tsx scripts/smoke-parts.ts",
    "smoke:crash": "tsx scripts/smoke-crash.ts",
    "smoke:batch": "tsx scripts/smoke-batch.ts",
    "doctor": "tsx scripts/doctor.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
